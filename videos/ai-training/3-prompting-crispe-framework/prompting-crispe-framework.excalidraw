      "isDeleted": false,
      "boundElements": null,
      "updated": 1717200000000,
      "link": null,
      "locked": false,
      "text": "This will be read aloud by a text-to-speech\nengine, so never use ellipses - it won't\nknow how to pronounce them.",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This will be read aloud by a text-to-speech\nengine, so never use ellipses - it won't\nknow how to pronounce them.",
      "lineHeight": 1.4
    },
    {
      "id": "txt-134",
