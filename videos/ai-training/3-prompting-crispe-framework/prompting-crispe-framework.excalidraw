      "isDeleted": false,
      "boundElements": null,
      "updated": 1717200000000,
      "link": null,
      "locked": false,
      "text": "Same rule. Only the second one lets Claude work out the cases you\ndidn't think to list.",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Same rule. Only the second one lets Claude work out the cases you\ndidn't think to list.",
