      "locked": false,
      "text": "Claude is a brilliant new colleague on their first day.\nGive the reason and it works out the rest itself.",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Claude is a brilliant new colleague on their first day.\nGive the reason and it works out the rest itself.",
      "lineHeight": 1.4
    },
