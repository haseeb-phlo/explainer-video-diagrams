      "boundElements": null,
      "updated": 1717200000000,
      "link": null,
      "locked": false,
      "text": "Nothing here says who it's for, what \"help\" means,\nor what a good answer looks like.",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Nothing here says who it's for, what \"help\" means,\nor what a good answer looks like.",
