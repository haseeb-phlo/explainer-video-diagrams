      "isDeleted": false,
      "boundElements": null,
      "updated": 1717200000000,
      "link": null,
      "locked": false,
      "text": "Show your prompt to a colleague with no context. If they'd\nbe confused, Claude will be too.",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Show your prompt to a colleague with no context. If they'd\nbe confused, Claude will be too.",
      "lineHeight": 1.4
    },
