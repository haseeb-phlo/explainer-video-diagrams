      "versionNonce": 112770859,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1717200000000,
      "link": null,
      "locked": false,
      "text": "Read only the sentences that\ncontain a commitment - a date,\na number, an obligation.",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Read only the sentences that\ncontain a commitment - a date,\na number, an obligation.",
      "lineHeight": 1.4
    },
    {
      "id": "txt-203",
      "type": "text",
      "x": 11120.0,
      "y": 476.0,
      "width": 271.04,
      "height": 61.599999999999994,
