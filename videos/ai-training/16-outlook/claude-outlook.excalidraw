      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Two jobs live in here, and they are not the same job.\nOne of them is deciding. The other is only wording.",
      "lineHeight": 1.4
    },
