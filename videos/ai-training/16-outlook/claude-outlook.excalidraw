      "version": 1,
      "versionNonce": 1900594208,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1717200000000,
      "link": null,
      "locked": false,
      "text": "Thanks for the revised schedule -\nthat all works our end. Happy to hold\nthe current volumes to the 26th, and\nwe can absorb the 4p uplift this\nquarter while the re-tender runs.\nAnything that slips beyond that sits\nwith us.",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Thanks for the revised schedule -\nthat all works our end. Happy to hold\nthe current volumes to the 26th, and\nwe can absorb the 4p uplift this\nquarter while the re-tender runs.\nAnything that slips beyond that sits\nwith us.",
      "lineHeight": 1.4
    },
