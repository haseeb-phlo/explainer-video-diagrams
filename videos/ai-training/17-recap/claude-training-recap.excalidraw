      "boundElements": null,
      "updated": 1717200000000,
      "link": null,
      "locked": false,
      "text": "That is not nothing. This was a mandatory course about a tool that changes every few\nmonths, and you sat through the awkward part - the one where you change how you work\nrather than watch somebody else do it.",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "That is not nothing. This was a mandatory course about a tool that changes every few\nmonths, and you sat through the awkward part - the one where you change how you work\nrather than watch somebody else do it.",
      "lineHeight": 1.4
    },
