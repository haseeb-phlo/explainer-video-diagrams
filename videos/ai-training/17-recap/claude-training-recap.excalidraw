      "isDeleted": false,
      "boundElements": null,
      "updated": 1717200000000,
      "link": null,
      "locked": false,
      "text": "Nobody here was ever going to ship something obviously broken - you would have\ncaught that. What gets through is the output that is well-made, plausible and\nempty. It gets through because a review checks whether it looks right.",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Nobody here was ever going to ship something obviously broken - you would have\ncaught that. What gets through is the output that is well-made, plausible and\nempty. It gets through because a review checks whether it looks right.",
      "lineHeight": 1.4
    },
