      "roundness": null,
      "seed": 2070932007,
      "version": 1,
      "versionNonce": 500612072,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1717200000000,
      "link": null,
      "locked": false,
      "text": "Claude will not reproduce a real brand's guidelines, and that refusal is\ncorrect - do not route around it. Take your rules from your own brand\nassets: if you cannot say where a colour came from, it is not yours.",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Claude will not reproduce a real brand's guidelines, and that refusal is\ncorrect - do not route around it. Take your rules from your own brand\nassets: if you cannot say where a colour came from, it is not yours.",
      "lineHeight": 1.4
    },
