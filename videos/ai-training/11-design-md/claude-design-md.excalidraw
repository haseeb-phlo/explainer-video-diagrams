    {
      "id": "txt-120",
      "type": "text",
      "x": 4126.0,
      "y": 830.0,
      "width": 887.0400000000001,
      "height": 92.39999999999999,
      "angle": 0.0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
