      "isDeleted": false,
      "boundElements": null,
      "updated": 1717200000000,
      "link": null,
      "locked": false,
      "text": "It draws everything with code - shapes, type, layout, motion. It does not\ntake photographs. Where a picture is needed it leaves you a space the right\nsize, and you bring a real one, or one from a tool you are allowed to use.",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "It draws everything with code - shapes, type, layout, motion. It does not\ntake photographs. Where a picture is needed it leaves you a space the right\nsize, and you bring a real one, or one from a tool you are allowed to use.",
      "lineHeight": 1.4
    },
