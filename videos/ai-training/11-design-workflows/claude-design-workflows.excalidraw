      "isDeleted": false,
      "boundElements": null,
      "updated": 1717200000000,
      "link": null,
      "locked": false,
      "text": "A shared design is a shared file. Nothing confidential goes in - no private\ncodebase, no unapproved work, nothing patient-facing - and anything that\ntouches records keeps the gate: Claude drafts, a person approves.",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A shared design is a shared file. Nothing confidential goes in - no private\ncodebase, no unapproved work, nothing patient-facing - and anything that\ntouches records keeps the gate: Claude drafts, a person approves.",
      "lineHeight": 1.4
    },
