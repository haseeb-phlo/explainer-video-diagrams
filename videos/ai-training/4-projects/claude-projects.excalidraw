      "isDeleted": false,
      "boundElements": null,
      "updated": 1717200000000,
      "link": null,
      "locked": false,
      "text": "As many as you like. And as a knowledge base gets close to the context\nlimit, Claude switches to retrieval on its own - up to 10 times the\ncapacity, with the same answer quality.",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
