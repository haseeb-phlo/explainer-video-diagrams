      "boundElements": null,
      "updated": 1717200000000,
      "link": null,
      "locked": false,
      "text": "It is not faster than you at deciding what the model should do. Use it where\nthoroughness beats judgement.",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "It is not faster than you at deciding what the model should do. Use it where\nthoroughness beats judgement.",
      "lineHeight": 1.4
    },
