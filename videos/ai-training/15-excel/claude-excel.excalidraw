      "updated": 1717200000000,
      "link": null,
      "locked": false,
      "text": "2 · long sessions compact",
      "fontSize": 28,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2 · long sessions compact",
      "lineHeight": 1.4
    },
    {
      "id": "txt-141",
      "type": "text",
      "x": 8072.0,
      "y": 704.0,
      "width": 887.0400000000001,
      "height": 61.599999999999994,
      "angle": 0.0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 651456687,
      "version": 1,
      "versionNonce": 1958193985,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1717200000000,
      "link": null,
      "locked": false,
      "text": "Long conversations are automatically compacted to avoid running out of\ncontext. The contract you set at the start is summarised, not preserved.",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Long conversations are automatically compacted to avoid running out of\ncontext. The contract you set at the start is summarised, not preserved.",
      "lineHeight": 1.4
    },
    {
      "id": "txt-142",
      "type": "text",
