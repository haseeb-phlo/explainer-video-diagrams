      "isDeleted": false,
      "boundElements": null,
      "updated": 1717200000000,
      "link": null,
      "locked": false,
      "text": "Re-state it. Minute forty does not still know what minute five was told.",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
