      "isDeleted": false,
      "boundElements": null,
      "updated": 1717200000000,
      "link": null,
      "locked": false,
      "text": "You are not the audience for “always double-check”. You already do that. The failure\nthat costs you is the one where every input is right, every formula is valid, every\nrange is correct - and the answer is still wrong, because the method was wrong.",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "You are not the audience for “always double-check”. You already do that. The failure\nthat costs you is the one where every input is right, every formula is valid, every\nrange is correct - and the answer is still wrong, because the method was wrong.",
      "lineHeight": 1.4
    },
    {
