      "roundness": null,
      "seed": 2132547460,
      "version": 1,
      "versionNonce": 63436875,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1717200000000,
      "link": null,
      "locked": false,
      "text": "Every other tool in this course fails where you can see it. A deck that says nothing\nlooks like a deck that says nothing. A spreadsheet fails differently: a plausible\nnumber, sitting in a cell, that nobody queries - and then it travels.",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Every other tool in this course fails where you can see it. A deck that says nothing\nlooks like a deck that says nothing. A spreadsheet fails differently: a plausible\nnumber, sitting in a cell, that nobody queries - and then it travels.",
      "lineHeight": 1.4
    },
