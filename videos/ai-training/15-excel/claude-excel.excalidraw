    },
    {
      "id": "txt-136",
      "type": "text",
      "x": 8072.0,
      "y": 356.0,
      "width": 423.36,
      "height": 39.199999999999996,
      "angle": 0.0,
      "strokeColor": "#364fc7",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
