      "locked": false,
      "text": "“Each row is one month. The spend figures are column B, rows 2 to 13.\nThe last column is worked out from the two before it - do not overwrite it.”",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "“Each row is one month. The spend figures are column B, rows 2 to 13.\nThe last column is worked out from the two before it - do not overwrite it.”",
      "lineHeight": 1.4
    },
