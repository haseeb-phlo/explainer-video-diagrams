      "isDeleted": false,
      "boundElements": null,
      "updated": 1717200000000,
      "link": null,
      "locked": false,
      "text": "two reasons what was true at minute five is\nnot true at minute forty",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "two reasons what was true at minute five is\nnot true at minute forty",
      "lineHeight": 1.4
    },
    {
