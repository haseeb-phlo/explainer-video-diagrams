      "versionNonce": 1963758987,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1717200000000,
      "link": null,
      "locked": false,
      "text": "A workbook from outside can carry instructions you did not write, and nothing\nconfidential or personal goes into a sheet you will share.\nClaude for Excel is not in Enterprise audit logs and does not inherit your\nretention settings - so your reconciliation IS the audit trail. Write it down.",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A workbook from outside can carry instructions you did not write, and nothing\nconfidential or personal goes into a sheet you will share.\nClaude for Excel is not in Enterprise audit logs and does not inherit your\nretention settings - so your reconciliation IS the audit trail. Write it down.",
      "lineHeight": 1.4
    },
