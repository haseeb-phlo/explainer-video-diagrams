      "seed": 731616613,
      "version": 1,
      "versionNonce": 1171341222,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1717200000000,
      "link": null,
      "locked": false,
      "text": "1 · it is not deterministic",
      "fontSize": 28,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1 · it is not deterministic",
      "lineHeight": 1.4
    },
    {
      "id": "txt-137",
      "type": "text",
      "x": 8072.0,
      "y": 414.0,
      "width": 936.32,
      "height": 61.599999999999994,
      "angle": 0.0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 524406866,
      "version": 1,
      "versionNonce": 1093719193,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1717200000000,
      "link": null,
      "locked": false,
      "text": "The same prompt, on the same workbook, twice, does not give you the same\nmodel twice. Different formulas, different structure, same plausible output.",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The same prompt, on the same workbook, twice, does not give you the same\nmodel twice. Different formulas, different structure, same plausible output.",
      "lineHeight": 1.4
    },
    {
      "id": "txt-138",
      "type": "text",
      "x": 8072.0,
      "y": 504.0,
      "width": 776.1600000000001,
      "height": 30.799999999999997,
      "angle": 0.0,
      "strokeColor": "#364fc7",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1349039035,
      "version": 1,
      "versionNonce": 1636927329,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1717200000000,
      "link": null,
      "locked": false,
      "text": "So “I checked it” is a claim about one run, not about the tool.",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "So “I checked it” is a claim about one run, not about the tool.",
      "lineHeight": 1.4
    },
