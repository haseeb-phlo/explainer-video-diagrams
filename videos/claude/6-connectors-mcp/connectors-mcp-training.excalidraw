      "versionNonce": 480970889,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1717200000000,
      "link": null,
      "locked": false,
      "text": "It lets Claude securely reach a specific tool to find things, fetch\ninformation, and - with your say-so - take an action.",
      "fontSize": 28,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "It lets Claude securely reach a specific tool to find things, fetch\ninformation, and - with your say-so - take an action.",
      "lineHeight": 1.4
    },
    {
