    {
      "id": "txt-075",
      "type": "text",
      "x": 2060.0,
      "y": 580.0,
      "width": 665.2800000000001,
      "height": 123.19999999999999,
      "angle": 0.0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 597589471,
      "version": 1,
      "versionNonce": 284489042,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1717200000000,
      "link": null,
      "locked": false,
      "text": "Every chat is its own bubble. Brilliant for one-off\nquestions. But unless you're inside a Project, Claude\ndoesn't carry your instructions or files from one chat\nto the next.",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Every chat is its own bubble. Brilliant for one-off\nquestions. But unless you're inside a Project, Claude\ndoesn't carry your instructions or files from one chat\nto the next.",
      "lineHeight": 1.4
    },
